# Supabase (프로젝트 생성 후 값 채우기)
VITE_SUPABASE_URL=your-supabase-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# 카카오맵 JS 앱키
VITE_KAKAO_MAP_KEY=your-kakao-map-js-key

# 통합 테스트(npm run test:integration)에만 쓴다. 앱은 이 값을 읽지 않는다.
#
# **VITE_ 접두사를 붙이지 말 것.** Vite는 VITE_로 시작하는 값을 번들에 그대로 넣으므로,
# 붙이면 브라우저를 여는 누구나 RLS를 지나갈 수 있게 된다.
#
# 통합 테스트는 이 키로 씨앗 데이터를 심고 치운다. 확인은 언제나 anon 키로 한다 —
# 서비스 키로 읽으면 정책이 꺼져서 "안 보여야 할 것이 안 보인다"를 검증할 수 없다.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
